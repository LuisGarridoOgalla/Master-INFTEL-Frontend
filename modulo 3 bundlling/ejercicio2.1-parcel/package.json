{
  "name": "ejercicio2.1-parcel",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "type-check": "tsc --noEmit",
    "type-check:watch": "npm run type-check -- --watch",
    "start:dev": "PARCEL_ENV=development rimraf dist && parcel ./src/index.html --open",
    "start:prod": "PARCEL_ENV=production rimraf dist && parcel ./src/index.html --open",
    "start": "run-p -l type-check:watch start:dev",
    "analyze": "parcel build src/index.html parcel-bundle-analyzer"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@types/node": "^22.13.9",
    "dotenv": "^16.4.7",
    "npm-run-all": "^4.1.5",
    "parcel-bundler": "^1.12.5",
    "rimraf": "^6.0.1",
    "sass": "^1.85.1",
    "typescript": "^5.8.2"
  },
  "dependencies": {
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
